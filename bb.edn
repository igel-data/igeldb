;; Babashka classpath for running IgelDB under bb (e.g. the bb smoke test).
;; The JVM build uses deps.edn; bb reads this file for :paths and :deps.
;; No org.clojure/data.fressian and no native pod -- IgelDB is pure Clojure.
{:paths ["src"]
 :deps {org.clojure/core.async {:mvn/version "1.9.865"}
        org.clojure/tools.logging {:mvn/version "1.3.1"}
        clj-commons/clj-yaml {:mvn/version "1.0.29"}
        com.igel-data/blossom {:mvn/version "2.0.2"}}}
