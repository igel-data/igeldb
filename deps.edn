{:deps {org.clojure/clojure {:mvn/version "1.12.5"}
        org.clojure/core.async {:mvn/version "1.9.865"}
        org.clojure/tools.logging {:mvn/version "1.3.1"}
        clj-commons/clj-yaml {:mvn/version "1.0.29"}
        com.igel-data/blossom {:mvn/version "2.0.2"}}

 :aliases {;; Run the IgelDB-vs-SQLite benchmark on the JVM. The same script runs
           ;; under Babashka via `bb bench/bench.clj`; comparing the two shows the
           ;; SCI interpretation overhead.
           :bench {:main-opts ["bench/bench.clj"]}

           :test {:extra-paths ["test"]
                  :extra-deps {io.github.cognitect-labs/test-runner
                               {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                  :exec-fn cognitect.test-runner.api/test}

           :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}
                          slipset/deps-deploy {:mvn/version "0.2.5"}}
                   :ns-default build}

           ;; Verify IgelDB with jepsen-lite. Kept off the main deps (it drags in
           ;; all of Jepsen). `clojure -M:jepsen --help` for the CLI, which is
           ;; jepsen-lite's own: `lite.runner` runs the suite that
           ;; `igeldb.jepsen` declares.
           :jepsen {:extra-paths ["jepsen"]
                    :extra-deps {com.igel-data/jepsen-lite
                                 {:git/url "https://github.com/igel-data/jepsen-lite.git"
                                  :git/sha "3951f778d052b5a2180f6f06860b5a2a45781e89"}}
                    :main-opts ["-m" "lite.runner" "igeldb.jepsen/suite"]}

           ;; The HTTP driver on its own, to poke at by hand. `clojure -M:jepsen
           ;; --profile process` starts and kills one of these itself. It needs
           ;; no jepsen-lite at all -- the driver is a program in its own right,
           ;; and must be runnable, and killable, without it anywhere near.
           :jepsen-driver {:extra-paths ["jepsen"]
                           :main-opts ["-m" "igeldb.driver"]}}}
