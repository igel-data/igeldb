{:deps {org.clojure/clojure {:mvn/version "1.12.5"}
        org.clojure/core.async {:mvn/version "1.9.865"}
        org.clojure/tools.logging {:mvn/version "1.3.1"}
        clj-commons/clj-yaml {:mvn/version "1.0.29"}
        com.igel-data/blossom {:mvn/version "2.0.2"}}

 :aliases {;; Run the IgelDB-vs-SQLite benchmark on the JVM. The same script runs
           ;; under Babashka via `bb bench/bench.clj`; comparing the two shows the
           ;; SCI interpretation overhead.
           :bench {:main-opts ["bench/bench.clj"]}

           :test {:extra-paths ["test"]
                  :extra-deps {io.github.cognitect-labs/test-runner
                               {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                  :exec-fn cognitect.test-runner.api/test}

           :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}
                          slipset/deps-deploy {:mvn/version "0.2.5"}}
                   :ns-default build}

           ;; Verify IgelDB with jepsen-lite. Kept off the main deps (it drags in
           ;; all of Jepsen). Run:
           ;;   clojure -M:jepsen [workload...] [crash|kill|power-off]
           ;;
           ;; `kill` needs jepsen-lite's :local-process target-type, so this sha
           ;; can't go back before it (M6, "other targets"); `power-off` needs
           ;; the lazyfs mount on top of it, which is this sha exactly. A git
           ;; dep and not :mvn/version because the newest release (0.1.0)
           ;; predates it -- and the :git/url is spelled out because the lib
           ;; name isn't one the CLI can infer a URL from.
           :jepsen {:extra-paths ["jepsen"]
                    :extra-deps {com.igel-data/jepsen-lite
                                 {:git/url "https://github.com/igel-data/jepsen-lite.git"
                                  :git/sha "07ecb2fa3395d003f621366c8720801922d7b16e"}}
                    :main-opts ["-m" "igeldb.jepsen"]}

           ;; The HTTP driver on its own, to poke at by hand. `clojure -M:jepsen
           ;; ... kill` starts and kills one of these itself.
           :jepsen-driver {:extra-paths ["jepsen"]
                           :extra-deps {com.igel-data/jepsen-lite
                                        {:git/url "https://github.com/igel-data/jepsen-lite.git"
                                         :git/sha "07ecb2fa3395d003f621366c8720801922d7b16e"}}
                           :main-opts ["-m" "igeldb.driver"]}}}
