{:deps {org.clojure/clojure {:mvn/version "1.12.5"}
        org.clojure/core.async {:mvn/version "1.6.681"}
        org.clojure/tools.logging {:mvn/version "1.2.4"}
        clj-commons/clj-yaml {:mvn/version "1.0.27"}
        blossom/blossom {:mvn/version "2.0.1"}}

 :aliases {;; Run the IgelDB-vs-SQLite benchmark on the JVM. The same script runs
           ;; under Babashka via `bb bench/bench.clj`; comparing the two shows the
           ;; SCI interpretation overhead.
           :bench {:main-opts ["bench/bench.clj"]}

           :test {:extra-paths ["test"]
                  :extra-deps {io.github.cognitect-labs/test-runner
                               {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                  :exec-fn cognitect.test-runner.api/test}

           ;; Verify IgelDB with jepsen-lite. Kept off the main deps (it drags in
           ;; all of Jepsen). Run: clojure -M:jepsen [workload...] [crash]
           :jepsen {:extra-paths ["jepsen"]
                    :extra-deps {io.github.yito88/jepsen-lite
                                 {:git/sha "42550047e0b8e2b8d646c67401d12879f439423d"}}
                    :main-opts ["-m" "igeldb.jepsen"]}}}
